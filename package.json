{
  "name": "eslint-plugin-fluent-html",
  "publishConfig": {
    "access": "public"
  },
  "version": "4.1.0",
  "description": "ESLint plugin for fluent-html - lint rules for setClass, variadic children, HTMX best practices, type-safe IDs, and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "USAGE.md"
  ],
  "scripts": {
    "gen:vocab": "node scripts/gen-vocab.mjs",
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node test/rule.test.js && node test/type-aware.test.js && node test/derivation.test.js && node test/vocab-drift.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JT-Digital-d-o-o/fluent-html.git",
    "directory": "eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/JT-Digital-d-o-o/fluent-html/issues"
  },
  "homepage": "https://github.com/JT-Digital-d-o-o/fluent-html/tree/main/eslint-plugin#readme",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "fluent-html",
    "tailwind",
    "linter",
    "code-quality"
  ],
  "author": "JT Digital d.o.o.",
  "contributors": [
    "Toni K. Turk"
  ],
  "license": "ISC",
  "peerDependencies": {
    "eslint": ">=7.0.0",
    "fluent-html": ">=8.0.0",
    "typescript": ">=4.7.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/eslint": "^8.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.0.0",
    "fluent-html": "github:JT-Digital-d-o-o/fluent-html#7cf5b2300a3b041049c6ec247efe84b20a272098",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
